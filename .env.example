# Copy to .env and fill in. Never commit the real .env file.

# Random long string used to sign session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./app.db

# Base URL the app is served from.
APP_BASE_URL=http://localhost:8000

# Razorpay (test mode). Dashboard → Settings → API keys → Regenerate Key.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Signing secret set when you create the webhook in the Razorpay Dashboard
# (Settings → Webhooks), used to verify incoming webhook payloads.
RAZORPAY_WEBHOOK_SECRET=...
