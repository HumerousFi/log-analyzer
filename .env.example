# Copy to .env and fill in. Never commit the real .env file.

# Random long string used to sign session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./app.db

# Base URL the app is served from (used to build Stripe redirect URLs).
APP_BASE_URL=http://localhost:8000

# Stripe (test mode). Use a restricted key (rk_test_...), not a full secret key,
# scoped to: Checkout Sessions (write), Billing Portal Sessions (write),
# Subscriptions (read), Customers (read).
STRIPE_SECRET_KEY=rk_test_...
# Price ID for the "Sentinel Monthly" subscription product/price in Stripe.
STRIPE_PRICE_ID=price_...
# Signing secret from `stripe listen` (local dev) or the webhook endpoint
# you create in the Stripe Dashboard (production).
STRIPE_WEBHOOK_SECRET=whsec_...
