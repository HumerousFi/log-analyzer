# Copy to .env and fill in. Never commit the real .env file.

# Random long string used to sign session cookies.
SECRET_KEY=change-me-to-a-long-random-string

# Defaults to a local SQLite file if unset. In the Docker Compose deploy,
# set this to sqlite:////app/data/app.db so the DB lands in the persistent
# app-data volume instead of the container's throwaway filesystem.
DATABASE_URL=sqlite:///./app.db

# Base URL the app is served from. Session cookies are only marked Secure
# when this is https://, so set it correctly before going live.
APP_BASE_URL=http://localhost:8000

# Public hostname for the Docker Compose deploy (Caddy requests a TLS cert
# for this). If you don't have a domain yet, use a sslip.io hostname that
# embeds your VPS's IP, e.g. IP 203.0.113.42 -> 203-0-113-42.sslip.io.
DOMAIN=

# Razorpay (test mode). Dashboard → Settings → API keys → Regenerate Key.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Signing secret set when you create the webhook in the Razorpay Dashboard
# (Settings → Webhooks), used to verify incoming webhook payloads.
RAZORPAY_WEBHOOK_SECRET=...

# SMTP, for email verification and password-reset emails. Leave SMTP_HOST
# blank in local dev - emails log to the console instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Sentinel <no-reply@yourdomain.com>
